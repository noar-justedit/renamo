{
  "name": "renamo",
  "version": "1.7.0",
  "description": "Batch file renamer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/ui.test.js && node test/safety.test.js && node test/linux.test.js",
    "build:mac": "electron-builder --mac --arm64",
    "build:mac-universal": "electron-builder --mac dmg --universal",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64"
  },
  "build": {
    "appId": "com.justedit.renamo",
    "productName": "renamo",
    "copyright": "Copyright © 2026 just edit",
    "afterSign": "scripts/notarize.js",
    "files": [
      "src/**/*",
      "build/icon.icns",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "11.0",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "renamo needs access to your Desktop to list and rename the files it contains.",
        "NSDocumentsFolderUsageDescription": "renamo needs access to your Documents to list and rename the files it contains.",
        "NSDownloadsFolderUsageDescription": "renamo needs access to your Downloads to list and rename the files it contains.",
        "NSRemovableVolumesUsageDescription": "renamo needs access to removable volumes to list and rename the files they contain.",
        "NSNetworkVolumesUsageDescription": "renamo needs access to network volumes to list and rename the files they contain."
      }
    },
    "dmg": {
      "title": "renamo ${version}",
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "renamo-${version}-mac-${arch}.dmg"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "renamo-${version}-win-${arch}.zip"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "renamo",
      "license": "build/license.txt",
      "artifactName": "renamo-Setup-${version}.exe"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility;FileTools",
      "maintainer": "just edit <contact@just-edit.fr>",
      "vendor": "just edit",
      "synopsis": "Batch rename files and folders with a live preview",
      "description": "Batch rename files and folders with a live preview. renamo only ever renames: it never deletes, never overwrites and never hides a file.",
      "executableName": "renamo",
      "desktop": {
        "entry": {
          "Keywords": "rename;batch;files;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "renamo-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "artifactName": "renamo_${version}_amd64.deb",
      "packageCategory": "utils"
    },
    "appImage": {
      "artifactName": "renamo-${version}-x86_64.AppImage"
    }
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {},
  "author": "just edit",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/noar-justedit/renamo.git"
  },
  "homepage": "https://github.com/noar-justedit/renamo",
  "bugs": {
    "url": "https://github.com/noar-justedit/renamo/issues"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "desktopName": "renamo.desktop"
}
