<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the Developer ID build.

  What Chromium/V8 needs to run under the hardened runtime, and nothing more.
  allow-dyld-environment-variables was dropped in 1.6.4: it let a DYLD_*
  variable inject code into the signed app, which holds the user's
  folder permissions.
  disable-library-validation was dropped in 1.8.1 for the same reason: renamo
  loads no third-party native module, so only code signed by the same team may
  load into the app. If the signed app ever refuses to start, this is the key
  to put back (see ETAT_PROJET.md).
  renamo is NOT sandboxed: it has to reach any volume the user points it at, so
  there is no com.apple.security.app-sandbox key here, and file access is governed
  by macOS TCC prompts instead (see extendInfo in package.json).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
